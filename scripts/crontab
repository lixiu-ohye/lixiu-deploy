# 哩修 AI影像助手 - 定时任务
# 编辑: crontab -e
# 查看: crontab -l

# ========== 每天凌晨3点：数据备份 ==========
0 3 * * * cd /opt/lixiu && bash scripts/backup.sh >> logs/backup.log 2>&1

# ========== 每周日凌晨4点：清理旧日志 ==========
0 4 * * 0 find /opt/lixiu/logs -name "*.log" -mtime +30 -delete

# ========== 每天凌晨2点：SSL证书检查续期 ==========
0 2 * * * cd /opt/lixiu && bash scripts/ssl-setup.sh >> logs/ssl-renewal.log 2>&1

# ========== 每小时：健康检查 ==========
0 * * * * curl -f -s http://localhost/health > /dev/null || bash scripts/notify.sh "健康检查失败"

# ========== 每30分钟：磁盘空间检查 ==========
*/30 * * * * bash scripts/check-disk.sh >> logs/disk-check.log 2>&1
